# Optional. Nothing here is required for the site to build or run — every feature
# below degrades to a safe no-op when its variable is absent.

# Powers the Cellar wine agent at /cellar. Without it the API answers 503 and the
# page says the service is unavailable.
ANTHROPIC_API_KEY=

# Sends the automatic confirmation after a form submission. Without it the reply
# endpoint answers {"sent":false,"reason":"not-configured"} and the lead is still
# captured by Formspree exactly as before.
# The sending domain has to be verified with Resend first.
RESEND_API_KEY=
LEAD_REPLY_FROM="Safar Isaev <saf@safarisaev.ai>"

# Turns the API rate limiter from an in-isolate counter into a real shared quota.
# Set both, or neither. Vercel KV exposes the same pair as KV_REST_API_URL and
# KV_REST_API_TOKEN, which are read as a fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
